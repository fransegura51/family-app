VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_VAPID_PUBLIC_KEY=
# Mapa de Ubicación y el selector de sitio en Calendario/Eventos (Maps
# JavaScript API + Places API (New) + Geocoding API). Se crea en el
# mismo proyecto de Google Cloud que ya usa "Conectar con Google
# Calendar" — ver docs/GOOGLE_MAPS.md para los pasos completos (activar
# facturación, las 3 APIs, la clave y los cupos para no pagar de más).
# Sin esta clave, el mapa no se pinta pero el resto de la pantalla sigue
# funcionando.
VITE_GOOGLE_MAPS_API_KEY=

# Comunidad PEPA: dirección pública de los enlaces para compartir (Worker de Cloudflare, ver docs/comunidad/GUIA_ENLACES_PUBLICOS.md).
# Sin ella, los enlaces para compartir usan la dirección de la propia web. También es la base de las FOTOS publicadas (`<base>/img/<ruta>`, el almacenamiento
# de Supabase es privado): sin ella las fotos se piden una a una con direcciones firmadas (funciona, pero cuesta más llamadas a Supabase). Ejemplo: https://pepafamilyapp.es/c
VITE_COMMUNITY_PUBLIC_BASE=
