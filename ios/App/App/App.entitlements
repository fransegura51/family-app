<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Avisos (APNs). «development» en el archivo: al preparar la versión para TestFlight/App Store, Xcode lo cambia a «production» según el perfil de firma. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
